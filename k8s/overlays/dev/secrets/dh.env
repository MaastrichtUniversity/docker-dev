# dh-secrets (dev values, mirroring .env / irods/s3.env / compose
# environment: blocks). Key names are the container-expected names - see
# k8s/README.md section 7 (secret inventory). tst/acc/prd: same keys,
# values from Vault via ExternalSecrets.
# iRODS
ENV_IRODS_PASSWORD_ADMIN=test_1234567890qpwoeirutyg
IRODS_PASS=test_1234567890qpwoeirutyg
ENV_IRODS_KEY_SERVER_ZONE=test_12345pqmzwoxneicyrhfAAA3232
ENV_IRODS_KEY_SERVER_NEGOTIATION=test_567890nceibxwuvzyqfsagjf8dk
ENV_IRODS_KEY_CONTROL_PLANE=test_ABCDErulswop1q2b3v4m5z6as98
ENV_IRODS_PASSWORDS_SALT=test_somesalthere
ENV_IRODS_DB_IRODS_PASSWORD=pgB3rKhqLGFLora
ENV_IRODS_DB_POSTGRES_PASSWORD=foobar
# Garage
GARAGE_RPC_SECRET=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
GARAGE_ADMIN_TOKEN=test_garage_admin_token
# S3 (garage) keys - ires-hnas-um + garage bootstrap
ENV_S3_ACCESS_KEY_AC=ABCDEFGHIJKLMNOPQRST
ENV_S3_SECRET_KEY_AC=ABCDEFGHIJKLMNOPQRSTUVWXYZABCDEFGHIJKLMNO
ENV_S3_ACCESS_KEY_GL=BCDEFGHIJKLMNOPQRSTU
ENV_S3_SECRET_KEY_GL=BCDEFGHIJKLMNOPQRSTUVWXYZABCDEFGHIJKLMNOP
# Elastic
ELASTIC_PASSWORD=test_1aqz2swx3dec4vfr
# epicpid (container env names are USERNAME/PASSWORD)
PASSWORD=test_lhkjdhfgqpow96312
# keycloak / ldap
KEYCLOAK_PASSWORD=admin
LDAP_ADMIN_PASSWORD=admin
# sram-sync
LDAP_PASS=admin
# admin-tools-backend
DB_PASSWORD=postgres
OIDC_CLIENT_SECRET=bar
SECRET_KEY=randomly_generated_secret_key
AIRFLOW_API_KEY=foobar
# mdr
MDR_POSTGRES_PASSWORD=foobar
DJANGO_SECRET_KEY=foobar
