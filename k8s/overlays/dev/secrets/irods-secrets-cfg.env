# dh-irods-secrets-cfg: env keys mirroring irods.secrets.cfg (dev values).
# The raw file is additionally shipped as the `irods.secrets.cfg` key
# (see the secretGenerator in kustomization.yaml) for the ires /etc/secrets
# mount consumed by irods-helper-cmd.
#
# Sensitive keys (Atlassian/BioPortal/reCAPTCHA) are PLACEHOLDERS - this
# file is committed to the public repo. Before building the dev overlay,
# copy the real values from the local gitignored ../../../irods.secrets.cfg
# into this file and keep that change local (do not commit it).
INGEST_PASSWORD=
INGEST_USER=
INGEST_MOUNT=
LDAP_PASSWORD=
LDAP_USER="CN=Rit-dev (DATAHUB),OU=Resources,OU=Users,OU=DATAHUB,OU=FHML,DC=unimaas,DC=nl"
LDAP_URL=ldap://ldap.maastrichtuniversity.nl
LDAP_DOMAIN=DC=unimaas,DC=nl
USE_SAMBA=false
DATAVERSE_TOKEN=
BIOPORTAL_API_KEY=<set-from-local-irods-secrets.cfg>
ATLASSIAN_API_USERNAME=datahub-service-qodmkq7w6o@serviceaccount.atlassian.com
ATLASSIAN_API_KEY=<set-from-local-irods-secrets.cfg>
REACT_APP_CAPTCHA_SECRET_KEY=<set-from-local-irods-secrets.cfg>
