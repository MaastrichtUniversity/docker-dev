# MDR (django) non-secret settings (compose: mdr.env with RIT_ENV=dev).
# Secrets -> dh-secrets (IRODS_PASS, ELASTIC_PASSWORD, MDR_POSTGRES_PASSWORD,
# DJANGO_SECRET_KEY) and dh-irods-secrets-cfg (BIOPORTAL_API_KEY,
# DATAVERSE_TOKEN, ...).
ENV=dev
# SAML (IDP metadata served through the public ingress)
SAML_IDP_METADATA_URL=http://keycloak.dev.dh.unimaas.nl/auth/realms/django/protocol/saml/descriptor
SAML_DJANGO_BASE_URL=http://app.mdr.dev.dh.unimaas.nl
SAML_DJANGO_WANT_ASSERTIONS_SIGNED=True
SAML_DJANGO_WANT_RESPONSE_SIGNED=False
SAML_DJANGO_USERNAME_ATTR=uid
SAML_DJANGO_FIRSTNAME_ATTR=givenName
SAML_DJANGO_LASTNAME_ATTR=sn
SAML_DJANGO_MAIL_ATTR=mail
# iRODS
IRODS_HOST=icat.irods.svc.cluster.local
IRODS_USER=rods
IRODS_CLIENT_SERVER_POLICY=CS_NEG_REQUIRE
TERMS_OF_SERVICE_TIMESTAMP=1618476699
# Elastic
ELASTIC_HOST=elastic.external.svc.cluster.local
ELASTIC_PORT=9200
# Mailing
EMAIL_HOST=placeholder.nl
# External applications
DISQOVER_URL=https://disqover.datahubmaastricht.nl/
MDR_ANSIBLE_VERSION_TAG=DEV
BIOPORTAL_URL=https://data.bioontology.org
LOGSPOUT=ignore
WEBDAV_DOWNLOAD_URL=download.dev.dh.unimaas.nl
WEBDAV_UPLOAD_URL=upload.dev.dh.unimaas.nl
JIRA_URL=https://api.atlassian.com/ex/jira/842be66c-b848-4ca8-97a2-19e210371deb
JIRA_PROJECT_KEY=DHDO
DATAHUB_HOME_URL=http://dev.dh.unimaas.nl
MDR_HOME_URL=http://mdr.dev.dh.unimaas.nl
# SMB (same fake values as compose dev)
SMB_UM_WINDOWS_PATH=\\foobar.unimaas.nl\iRODS-ingestzones\dev
SMB_UM_UNIX_PATH=foobar.unimaas.nl/iRODS-ingestzones/dev
SMB_MUMC_WINDOWS_PATH=\\foobar.prd.corp\dev
SMB_MUMC_UNIX_PATH=foobar.prd.corp/dev
# Django
CACHE_TTL_VALUE=86400
DJANGO_DEV_MODE=True
# Postgres
MDR_POSTGRES_HOST=mdr-db.external.svc.cluster.local
MDR_POSTGRES_DB=mdr
MDR_POSTGRES_USER=postgres
# Drag and Drop
DRAG_AND_DROP_MAX_FILES=100
DRAG_AND_DROP_MAX_SIZE=50
# Help-center
HELP_CENTER_HOST=http://help.mdr.dev.dh.unimaas.nl
# CSP
CSP_CONNECT_SRC_HELP_CENTER=help.mdr.dev.dh.unimaas.nl
CSP_IAM_PROVIDER=keycloak.dev.dh.unimaas.nl
