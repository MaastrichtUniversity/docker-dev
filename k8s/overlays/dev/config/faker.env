# dh-faker job settings (compose: dh-faker environment:).
# IRODS_PASS -> icat-app-secrets. The remoteResource job argument (see
# k8s/base/faker/job-template.yaml) must be
# ires-hnas-um.irods.svc.cluster.local (k8s/dh-local-worklist.md B).
IRODS_HOST=icat.irods.svc.cluster.local
IRODS_USER=rods
IRODS_CLIENT_SERVER_POLICY=CS_NEG_REQUIRE
LOG_LEVEL=INFO
