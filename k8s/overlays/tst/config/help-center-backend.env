# help-center-backend non-secret settings (compose: help-center-backend environment:).
# ATLASSIAN_API_USERNAME/KEY + REACT_APP_CAPTCHA_SECRET_KEY ->
# dh-irods-secrets-cfg.
FORWARDED_ALLOW_IPS=*
CONFLUENCE_CLOUD_URL=https://mumc.atlassian.net
CONFLUENCE_API_URL=https://api.atlassian.com/ex/confluence/01677488-5820-413a-a14a-c273420a3100
CONFLUENCE_CLOUD_SPACE_KEY=MDRDT
LOGSPOUT=ignore
WATCHFILES_FORCE_POLLING=true
AUTO_RELOAD=true
# CORS allow-list origins (backend main.py). Must match the scheme of the
# browser page that embeds the help center - MDR/DH pages are https (SAML).
MDR_URL=https://app.mdr.tst.dh.unimaas.nl
MDR_HOME_URL=https://mdr.tst.dh.unimaas.nl
DH_HOME_URL=https://tst.dh.unimaas.nl
JIRA_URL=https://api.atlassian.com/ex/jira/842be66c-b848-4ca8-97a2-19e210371deb
JIRA_SERVICE_DESK_PROJECT_NAME=DataHub Service Desk
JIRA_SERVICE_DESK_QUESTION_REQUEST_NAME=Ask a question
JIRA_SERVICE_DESK_BUG_REQUEST_NAME=Bug report
JIRA_SERVICE_DESK_FEATURE_REQUEST_NAME=Feature request
JIRA_SERVICE_DESK_SUPPORT_REQUEST_NAME=Support request
JIRA_SERVICE_DESK_EXTERNAL_ACCESS_REQUEST_NAME=External Access Request
JIRA_SERVICE_DESK_AUTOMATED_PROCESS_SUPPORT_REQUEST_NAME=Automated process support request
JIRA_SERVICE_DESK_DATA_DELETION_REQUEST_NAME=Data deletion request
JIRA_SERVICE_DESK_DELETION_NOTICE_REQUEST_NAME=Dropzone deletion notice
JIRA_SERVICE_DESK_AUTO_INGEST_NOTICE_REQUEST_NAME=Dropzone auto ingest notice
# Corporate proxy for outbound calls to Atlassian (direct egress hangs with ReadTimeout).
HTTP_PROXY=http://proxy.unimaas.nl:3128
HTTPS_PROXY=http://proxy.unimaas.nl:3128
# Keep internal calls (MDR, home, in-cluster services) direct.
NO_PROXY=localhost,127.0.0.1,.tst.dh.unimaas.nl,.svc.cluster.local
