# sram-sync (LDAP <-> iRODS sync) settings (compose: sram-sync environment:).
# IRODS_PASS + LDAP_PASS -> dh-secrets.
LOG_LEVEL=INFO
IRODS_HOST=icat.irods.svc.cluster.local
IRODS_USER=rods
IRODS_CLIENT_SERVER_POLICY=CS_NEG_REQUIRE
LDAP_USER=cn=admin,dc=datahubmaastricht,dc=nl
LDAP_HOST=ldap://ldap.internal.svc.cluster.local
LDAP_USERS_BASE_DN=ou=People,dc=flat,dc=datahubmaastricht,dc=nl
LDAP_GROUPS_BASE_DN=ou=Groups,dc=flat,dc=datahubmaastricht,dc=nl
LDAP_COS_BASE_DN=dc=ordered,dc=datahubmaastricht,dc=nl
DEFAULT_USER_PASSWORD=foobar
LOGSTASH_TAGS=SRAMSYNC
SYNC_USERS=True
DELETE_USERS=True
SYNC_GROUPS=True
DELETE_GROUPS=True
# Corporate proxy for outbound HTTP(S) calls (direct egress times out).
HTTP_PROXY=http://proxy.unimaas.nl:3128
HTTPS_PROXY=http://proxy.unimaas.nl:3128
# Keep internal calls (in-cluster services, *.tst.dh.unimaas.nl) direct.
NO_PROXY=localhost,127.0.0.1,.tst.dh.unimaas.nl,.svc.cluster.local
