# admin-tools-backend non-secret settings (compose: admin-tools-backend environment:).
# Secrets -> dh-secrets (DB_PASSWORD, IRODS_PASS, OIDC_CLIENT_SECRET,
# SECRET_KEY, AIRFLOW_API_KEY) and dh-irods-secrets-cfg (ATLASSIAN_*).
DB_USER=postgres
DB_NAME=dhadmin
DB_HOST=admin-tools-db.internal.svc.cluster.local
DB_PORT=5432
IRODS_HOST=icat.irods.svc.cluster.local
IRODS_USER=rods
IRODS_CLIENT_SERVER_POLICY=CS_NEG_REQUIRE
SMTP_SERVER=smtp.maastrichtuniversity.nl
SMTP_PORT=25
EMAIL_SENDER=datahub-support@maastrichtuniversity.nl
EMAIL_FRIENDLY_NAME=DataHub Support
WATCHFILES_FORCE_POLLING=true
AUTO_RELOAD=true
CACHE_TTL_VALUE=86400
JIRA_URL=https://api.atlassian.com/ex/jira/842be66c-b848-4ca8-97a2-19e210371deb
PROJECT_KEY=DHS
ADMINISTRATION_EPIC_KEY=DH-181
TRANSITION_ID_REVIEW=11
TRANSITION_ID_DONE=61
CONTROLLER_EMAIL=tim.lustberg@maastrichtuniversity.nl
LINK_EMAIL=tim.lustberg@maastrichtuniversity.nl;d.linssen@maastrichtuniversity.nl
# OIDC is disabled on dev and tst (AUTH_DISABLED), like compose
OIDC_DOMAIN=auth.tst.dh.unimaas.nl
OIDC_CLIENT_ID=foo
AUTH_DISABLED=true
AUTO_INGEST_TEST_MINUTES=1
FRONTEND_URL=admin.tst.dh.unimaas.nl
SECURE_COOKIES=true
HELP_CENTER_HOST=http://help.mdr.tst.dh.unimaas.nl
VIRTUAL_HOST=admintoolsbackend.tst.dh.unimaas.nl
