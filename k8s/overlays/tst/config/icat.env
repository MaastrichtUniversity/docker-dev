# iCAT-specific non-secret settings (compose: icat environment: block).
# DB passwords come from the dh-secrets Secret.
ENV_IRODS_DB_HOSTNAME=irods-db.irods.svc.cluster.local
ENV_IRODS_DB_NAME=icat
ENV_IRODS_DB_USERNAME=irods
ENV_IRODS_DB_PORT=5432
# File names in /opt/irods_ssl_staging (keys of the icat-tls Secret)
ENV_IRODS_SSL_CERT=icat.dh.local.crt
ENV_IRODS_SSL_KEY=icat.dh.local.key
ENV_IRODS_SSL_DH_PARAMS=dhparams.pem
ENV_IRODS_SSL_CA_CERTIFICATE=test_only_tst_irods_dh_ca_cert.pem
ENV_FILEBEAT_PRIMARY_TAG=ICAT
# Corporate proxy for outbound HTTPS (e.g. the ruleset's GitHub dependency).
HTTP_PROXY=http://proxy.unimaas.nl:3128
HTTPS_PROXY=http://proxy.unimaas.nl:3128
# Keep cluster services and TST hosts direct.
NO_PROXY=localhost,127.0.0.1,.tst.dh.unimaas.nl,.svc.cluster.local
