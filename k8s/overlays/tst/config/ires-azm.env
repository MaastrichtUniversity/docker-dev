# ires-hnas-AZM non-secret settings (compose: ires-hnas-azm environment: block).
# ENV_IRODS_HOST_RESC_NAME replaces the old ${HOSTNAME%%.dh.local}Resource
# derivation in the (vendored) hooks - same value as compose produced.
ENV_IRODS_HOST_RESC_NAME=ires-hnas-azmResource
ENV_IRODS_SSL_CERT=ires-hnas-azm.dh.local.crt
ENV_IRODS_SSL_KEY=ires-hnas-azm.dh.local.key
ENV_IRODS_SSL_DH_PARAMS=dhparams.pem
ENV_IRODS_SSL_CA_CERTIFICATE=test_only_tst_irods_dh_ca_cert.pem
ENV_FILEBEAT_PRIMARY_TAG=IRES
ENV_FILEBEAT_SECONDARY_TAG=IRES_AZM
ENV_DIRECT_INGEST_RESOURCE=false
ENV_IRODS_COOR_RESC_NAME=replRescAZM02
ENV_IRODS_STOR_RESC_NAME=AZM-storage2
ENV_IRODS_HOST_RESC_COMMENT=AZM-UBUNTU-INGEST-RESOURCE
ENV_IRODS_COOR_RESC_COMMENT=Replicated-resource-for-AZM
ENV_IRODS_COOR_RESC_PRICING=0
