# MDR (django) non-secret settings (compose: mdr.env with RIT_ENV=dev).
# Secrets -> dh-secrets (IRODS_PASS, ELASTIC_PASSWORD, MDR_POSTGRES_PASSWORD,
# DJANGO_SECRET_KEY) and dh-irods-secrets-cfg (BIOPORTAL_API_KEY,
# DATAVERSE_TOKEN, ...).
ENV=tst
# SAML (IDP metadata served through the public ingress)
# https: browsers reject the djangosaml2 saml_session cookie (SameSite=None)
# without Secure, and the SSO redirect + ACS must therefore run over https.
# (See gateway.yaml "Follow-up" note: flip app URLs to https.)
SAML_IDP_METADATA_URL=https://keycloak.tst.dh.unimaas.nl/auth/realms/django/protocol/saml/descriptor
SAML_DJANGO_BASE_URL=https://app.mdr.tst.dh.unimaas.nl
SAML_DJANGO_WANT_ASSERTIONS_SIGNED=True
SAML_DJANGO_WANT_RESPONSE_SIGNED=False
SAML_DJANGO_USERNAME_ATTR=uid
SAML_DJANGO_FIRSTNAME_ATTR=givenName
SAML_DJANGO_LASTNAME_ATTR=sn
SAML_DJANGO_MAIL_ATTR=mail
# iRODS
IRODS_HOST=icat.irods.svc.cluster.local
IRODS_USER=rods
IRODS_CLIENT_SERVER_POLICY=CS_NEG_REQUIRE
TERMS_OF_SERVICE_TIMESTAMP=1618476699
# Elastic
ELASTIC_HOST=elastic.external.svc.cluster.local
ELASTIC_PORT=9200
# Mailing
EMAIL_HOST=placeholder.nl
# External applications
DISQOVER_URL=https://disqover.datahubmaastricht.nl/
MDR_ANSIBLE_VERSION_TAG=TST
BIOPORTAL_URL=https://data.bioontology.org
LOGSPOUT=ignore
WEBDAV_DOWNLOAD_URL=download.tst.dh.unimaas.nl
WEBDAV_UPLOAD_URL=upload.tst.dh.unimaas.nl
JIRA_URL=https://api.atlassian.com/ex/jira/842be66c-b848-4ca8-97a2-19e210371deb
JIRA_PROJECT_KEY=DHDO
DATAHUB_HOME_URL=http://tst.dh.unimaas.nl
MDR_HOME_URL=http://mdr.tst.dh.unimaas.nl
# SMB (same fake values as compose dev)
SMB_UM_WINDOWS_PATH=\\foobar.unimaas.nl\iRODS-ingestzones\tst
SMB_UM_UNIX_PATH=foobar.unimaas.nl/iRODS-ingestzones/tst
SMB_MUMC_WINDOWS_PATH=\\foobar.prd.corp\tst
SMB_MUMC_UNIX_PATH=foobar.prd.corp/tst
# Django
CACHE_TTL_VALUE=86400
# False => SESSION_COOKIE_SECURE (saml_session needs Secure for SameSite=None)
DJANGO_DEV_MODE=False
# Postgres
MDR_POSTGRES_HOST=mdr-db.external.svc.cluster.local
MDR_POSTGRES_DB=mdr
MDR_POSTGRES_USER=postgres
# Drag and Drop
DRAG_AND_DROP_MAX_FILES=100
DRAG_AND_DROP_MAX_SIZE=50
# Help-center
# Browser-facing: MDR pages are https (SAML), so the integrated help center
# JS (helpCenterUrl in base.html) must fetch https - otherwise the browser
# blocks it. The MDR pod's own server-side calls (submit_request/...) go to
# this public name via the hostAlias in patches/mdr-hostaliases.yaml.
HELP_CENTER_HOST=https://help.mdr.tst.dh.unimaas.nl
# CSP: value is passed through verbatim into connect-src - a schemeless host
# is an invalid CSP source and dropped by browsers, so the scheme is required.
CSP_CONNECT_SRC_HELP_CENTER=https://help.mdr.tst.dh.unimaas.nl
CSP_IAM_PROVIDER=keycloak.tst.dh.unimaas.nl
# Corporate proxy for outbound HTTP(S) calls (direct egress times out).
HTTP_PROXY=http://proxy.unimaas.nl:3128
HTTPS_PROXY=http://proxy.unimaas.nl:3128
# Keep internal calls (in-cluster services, *.tst.dh.unimaas.nl) direct.
NO_PROXY=localhost,127.0.0.1,.tst.dh.unimaas.nl,.svc.cluster.local
