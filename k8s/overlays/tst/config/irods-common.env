# Shared non-secret iRODS settings (compose: the common part of .env).
# Consumed by: icat, ires-hnas-um, ires-hnas-azm (+ their init containers).
# Keep ENV_ENVIRONMENT=dev because dh-irods's print_is_dev_env() requires
# "dev" to run the bootstrap hooks and mock project creation.
ENV_ENVIRONMENT=dev
ENV_IRODS_VERSION=4.3.5-0~noble
ENV_IRODS_PYTHON_PLUGIN_VERSION=4.3.5.0-0+4.3.5~noble
ENV_IRODS_RESC_PLUGIN_S3_VERSION=4.3.5.0-0+4.3.5~noble
ENV_IRODS_UID=999
ENV_IRODS_GID=999
ENV_IRODS_ICAT_HOST=icat.irods.svc.cluster.local
ENV_IRODS_DB_HOSTNAME=irods-db.irods.svc.cluster.local
ENV_IRODS_INGEST_REMOVE_DELAY=300s
ENV_IRODS_TEMP_PASSWORD_LIFETIME=7776000
ENV_S3_AUTH_FILE_AC=/var/lib/irods/garage1.keypair
ENV_S3_AUTH_FILE_GL=/var/lib/irods/garage2.keypair
ENV_GARAGE_VERSION=v2.3.0
ENV_EPICPID_URL=http://epicpid.irods.svc.cluster.local/epic/21.T12996/
ENV_EPICPID_USER=user
ENV_HC_BACKEND_URL=http://help-center-backend.public.svc.cluster.local:8000
ENV_MDR_HANDLE_URL=http://mdr.tst.dh.unimaas.nl/hdl/
ENV_DEBUG_DH_BOOTSTRAP=no
ENV_DOCKERIZE_VERSION=v0.2.0
ENV_FILEBEAT_VERSION=9.3.2
ENV_POSTGRES_CLIENT_VERSION=17
# ELK reused from the monitoring namespace (Grafana/Loki later)
ENV_FILEBEAT_HOST=elk.monitoring.svc.cluster.local
