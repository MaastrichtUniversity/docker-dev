# Keycloak settings (compose: keycloak environment:).
# KEYCLOAK_PASSWORD + LDAP_ADMIN_PASSWORD -> dh-secrets.
# The realm's LDAP federation uses the single-label name "ldap", which
# resolves to the ldap Service in this same (internal) namespace.
KEYCLOAK_USER=admin
# External base URL for generated links (SAML SSO Location in the IdP
# metadata, login-page links, OIDC issuer): the public gateway name, so
# browser-side SAML redirects reach Keycloak over https.
KEYCLOAK_FRONTEND_URL=https://keycloak.tst.dh.unimaas.nl/auth
