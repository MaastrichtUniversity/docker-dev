# ires-hnas-UM non-secret settings (compose: ires-hnas-um environment: block).
# S3 access/secret keys come from the dh-secrets Secret.
# ENV_IRODS_HOST_RESC_NAME replaces the old ${HOSTNAME%%.dh.local}Resource
# derivation in the (vendored) hooks - same value as compose produced.
ENV_IRODS_HOST_RESC_NAME=ires-hnas-umResource
ENV_IRODS_SSL_CERT=ires-hnas-um.dh.local.crt
ENV_IRODS_SSL_KEY=ires-hnas-um.dh.local.key
ENV_IRODS_SSL_DH_PARAMS=dhparams.pem
ENV_IRODS_SSL_CA_CERTIFICATE=test_only_tst_irods_dh_ca_cert.pem
ENV_FILEBEAT_PRIMARY_TAG=IRES
ENV_FILEBEAT_SECONDARY_TAG=IRES_UM03
ENV_DIRECT_INGEST_RESOURCE=true
ENV_IRODS_COOR_RESC_NAME=passRescUM01
ENV_IRODS_STOR_RESC_NAME=UM-hnas-4k
ENV_IRODS_HOST_RESC_COMMENT=UM-UBUNTU-INGEST-RESOURCE
ENV_IRODS_COOR_RESC_COMMENT=Passthru-resource-for-UM
ENV_IRODS_COOR_RESC_PRICING=0.130
ENV_S3_RESC_NAME_AC=UM-Ceph-S3-AC
ENV_S3_HOST_AC=garage1-s3-tls.irods.svc.cluster.local:9000
ENV_S3_RESC_NAME_GL=UM-Ceph-S3-GL
ENV_S3_HOST_GL=garage2-s3-tls.irods.svc.cluster.local:9000
# garage bootstrap init container (layout/bucket/keys)
GARAGE_BUCKET=dh-irods-bucket-tst
